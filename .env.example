# ============================================
# Variables de entorno para Docker Compose
# ============================================
# 
# Copia este archivo a .env y modifica los valores según necesites
# cp .env.example .env

# Puertos de los servicios
BACKEND_PORT=8085
FRONTEND_PORT=3000

# URL del backend (para GitHub Codespaces)
# Si estás en local, usa: http://localhost:8085
# Si estás en Codespaces, usa la URL de tu Codespace
BACKEND_URL=http://localhost:8085

# Usuario de Docker Hub
DOCKERHUB_USERNAME=jossuetorres

# ============================================
# Ejemplo para GitHub Codespaces:
# ============================================
# 
# BACKEND_URL=https://tu-codespace-nombre-8085.app.github.dev
#
# ============================================
# Ejemplos de puertos personalizados:
# ============================================
# 
# BACKEND_PORT=9090
# FRONTEND_PORT=4000
