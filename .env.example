# ============================================
# Variables de entorno para Docker Compose
# ============================================
# 
# Copia este archivo a .env y modifica los valores según necesites
# cp .env.example .env

# Puerto de la aplicación (por defecto: 8085)
APP_PORT=8085

# Usuario de Docker Hub (reemplaza con tu usuario)
DOCKERHUB_USERNAME=jossuetorres

# ============================================
# Ejemplos de configuración de puertos:
# ============================================
# 
# Para puerto 8080:
# APP_PORT=8080
#
# Para puerto 9090:
# APP_PORT=9090
#
# Para puerto 3000:
# APP_PORT=3000
